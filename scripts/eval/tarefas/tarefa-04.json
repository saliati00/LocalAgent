{
  "id": "script-python",
  "titulo": "Criar um script Python que imprime um texto",
  "prompt": "Crie o arquivo workspace/eval/ola.py que imprime a frase ola mundo.",
  "setup": {},
  "aceite": [
    {
      "type": "file_exists",
      "path": "workspace/eval/ola.py"
    },
    {
      "type": "file_contains",
